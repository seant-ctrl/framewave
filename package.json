{
  "name": "framewave",
  "productName": "Framewave",
  "version": "0.1.0",
  "description": "A powerful screen recorder and video editor with auto-zoom, cursor effects, backgrounds, captions and studio-grade export.",
  "main": "./out/main/index.js",
  "author": "Sean",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "ffmpeg-static": "^5.2.0",
    "koffi": "^3.2.1",
    "mediabunny": "^1.55.7",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "koffi@3.2.1": true,
    "uiohook-napi@1.5.5": true
  }
}
